# Copy to .env (never commit .env). start-local.bat sets these for local runs.
ENV=production
HOST_PORT=4002
WRITE_DB_SRV_HOST=localhost
WRITE_DB_PORT=3306
WRITE_DB_USER=
WRITE_DB_PASSWORD=
WRITE_DB_DATABASE=thanjai_restaurant

# Long random string; changing it logs everyone out
JWT_SECRET=
JWT_TTL=7d

# Allowed browser origins (comma separated)
CORS_ORIGINS=https://pm.thanjaicaterers.com,https://localhost,capacitor://localhost

# Invoice dates use this timezone
INVOICE_TZ=America/Toronto

# debug = verbose server log
LOG_LEVEL=

# ---- Online shop (weekly meal subscriptions) ----
# Organisation the public shop sells for
SHOP_ORG_ID=TR
# Stripe (leave empty = TEST MODE: orders are marked paid without charging a card)
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe dashboard (endpoint: https://<host>/v1/shop/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Y = run each week's cutoff automatically when its cutoff time passes (otherwise staff press "Run cutoff")
SUB_AUTO_CUTOFF=

# ---- Table reservations ----
# Address of this app, used in e-mail links (view / cancel booking)
PUBLIC_APP_URL=https://pm.thanjaicaterers.com/v1
# Organisation the public booking page books for (defaults to SHOP_ORG_ID, then TR)
RES_ORG_ID=
# E-mail (SMTP). Empty SMTP_HOST = no e-mail is sent, each message is written to the server log instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=thanjairestaurant@gmail.com, SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Thanjai Restaurant <thanjairestaurant@gmail.com>

# ---- Tanjo Foods shop (/v1/tanjo) - its own database, never thanjai_restaurant ----
# Only TANJO_ settings are read by the shop. Set up / update its database with:
#   sudo node tanjofoods/api/scripts/setup-db.js
TANJO_DB_HOST=localhost
TANJO_DB_PORT=3306
TANJO_DB_NAME=Tanjofoods
TANJO_DB_USER=tanjo_app
TANJO_DB_PASSWORD=
# Admin login used only by setup-db. On the VPS leave the password empty and use the socket (run setup-db with sudo)
TANJO_DB_ADMIN_USER=root
TANJO_DB_ADMIN_PASSWORD=
TANJO_DB_ADMIN_SOCKET=/var/run/mysqld/mysqld.sock
# First shop-admin login (created only when the shop has no admin users)
TANJO_ADMIN_NAME=
TANJO_ADMIN_EMAIL=
TANJO_ADMIN_PASSWORD=
# Address of the shop, used in e-mail links
TANJO_PUBLIC_URL=https://pm.thanjaicaterers.com/v1/tanjo
# MOCK = test payment page, no card is charged
TANJO_PAYMENT_MODE=MOCK
# Product photos named by SKU (TF-SN-001.jpg). Keep OUTSIDE the code folder so deploys never touch them
TANJO_PRODUCT_IMAGE_DIR=/home/thanjai/tanjo-images
# Shop e-mail. Empty TANJO_SMTP_HOST = e-mails are saved in tanjofoods/api/outbox instead of being sent
TANJO_SMTP_HOST=
TANJO_SMTP_PORT=465
TANJO_SMTP_SECURE=true
TANJO_SMTP_USER=
TANJO_SMTP_PASSWORD=
TANJO_MAIL_FROM=Tanjo Foods <info@tanjofoods.com>

# ------------------------------------------------------------------
# Tanjo Foods API – copy this file to ".env" and fill in the values
# ------------------------------------------------------------------

# Web server
PORT=4100
PUBLIC_URL=http://localhost:4100

# MySQL server
DB_HOST=localhost
DB_PORT=3306
DB_NAME=Tanjofoods

# Admin login – used ONLY by "npm run setup-db" to create the database
# and the dedicated app user below. Not used while the site is running.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Dedicated app login – can ONLY access the Tanjofoods database.
# setup-db creates it if it does not exist.
DB_USER=tanjo_app
DB_PASSWORD=ChangeMe_Tanjo2026!

# First admin login for http://localhost:4100/admin.html
# Used only by "npm run setup-db" when no admin user exists yet. Add more users in Admin > Users.
ADMIN_NAME=Rajesh
ADMIN_EMAIL=admin@tanjofoods.com
ADMIN_PASSWORD=Tanjo@2026

# Folder for product photos named by SKU (TF-SN-001.jpg, TF-SN-001_2.jpg ...).
# Leave empty for the default: Tanjofoods\product-images
PRODUCT_IMAGE_DIR=

# Payments: MOCK = built-in test payment page (no real money)
PAYMENT_MODE=MOCK

# E-mail. Leave SMTP_HOST empty to write e-mails to api/outbox/ instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tanjo Foods <info@tanjofoods.com>"
